# Application
APP_NAME=LinguaMeet AI
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/linguameet

# JWT
JWT_SECRET=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# IBM Watson Speech to Text
IBM_STT_API_KEY=
IBM_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# IBM Watson Language Translator
IBM_TRANSLATOR_API_KEY=
IBM_TRANSLATOR_URL=https://api.us-south.language-translator.watson.cloud.ibm.com

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloud Object Storage (optional)
IBM_COS_API_KEY=
IBM_COS_INSTANCE_CRN=
IBM_COS_ENDPOINT=

# Demo Mode (set to true when IBM credentials are not configured)
DEMO_MODE=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
